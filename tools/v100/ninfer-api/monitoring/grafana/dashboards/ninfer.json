    {
      "id": 4,
      "type": "stat",
      "title": "MTP acceptance rate",
      "datasource": {
        "type": "prometheus",
        "uid": "ninfer-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ninfer_speculative_accepted_tokens_total[1m]) / rate(ninfer_speculative_drafted_tokens_total[1m])",
          "legendFormat": "session",
          "instant": false,
          "range": true
        },
        {
          "refId": "A",
          "expr": "ninfer_speculative_live_accepted_tokens / ninfer_speculative_live_drafted_tokens",
          "legendFormat": "running now",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
