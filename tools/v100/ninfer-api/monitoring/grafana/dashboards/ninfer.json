    {
      "id": 9,
      "type": "piechart",
      "title": "Main KV pool (pages): free vs mapped vs shared-held",
      "datasource": {
        "type": "prometheus",
        "uid": "ninfer-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 14
