{
  "uid": "ninfer",
  "title": "NInfer (2xV100, 200k single session)",
  "tags": [
    "ninfer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decode speed",
      "datasource": {
        "type": "prometheus",
        "uid": "ninfer-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ninfer_decode_tokens_total[5m])",
          "legendFormat": "decode tok/s",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Rates use a five-minute window (thirty for the session acceptance) so a finished burst stays readable; zero means the server is idle."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prefill speed",
      "datasource": {
        "type": "prometheus",
