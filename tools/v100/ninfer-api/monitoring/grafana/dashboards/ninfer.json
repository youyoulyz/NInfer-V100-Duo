      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ninfer_prefill_tokens_total[5m])",
          "legendFormat": "prefill tok/s",
