      "targets": [
        {
          "refId": "A",
          "expr": "sum(ninfer_kv_page_groups{pool=\"main\",state=\"free\"})",
          "legendFormat": "free",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(ninfer_kv_page_groups{pool=\"main\",state=\"capacity\"}) - sum(ninfer_kv_page_groups{pool=\"main\",state=\"free\"}) - sum(ninfer_kv_page_groups{pool=\"main\",state=\"shared_held\"})",
