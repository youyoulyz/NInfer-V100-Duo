        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Rates use a five-minute window (thirty for the session acceptance) so a finished burst stays readable; zero means the server is idle."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Average decode batch",
      "datasource": {
        "type": "prometheus",
        "uid": "ninfer-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ninfer_decode_rows_total[5m]) / rate(ninfer_decode_rounds_total[5m])",
          "legendFormat": "rows/round",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Average rows per decode round over the last five minutes. Empty while the server is idle, because there is no batch to average."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "MTP acceptance rate",
      "datasource": {
        "type": "prometheus",
        "uid": "ninfer-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ninfer_speculative_accepted_tokens_total[30m]) / rate(ninfer_speculative_drafted_tokens_total[30m])",
          "legendFormat": "session",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "ninfer_speculative_live_accepted_tokens / ninfer_speculative_live_drafted_tokens",
          "legendFormat": "running now",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Rates use a five-minute window (thirty for the session acceptance) so a finished burst stays readable; zero means the server is idle."
    },
